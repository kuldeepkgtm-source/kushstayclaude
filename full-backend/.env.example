APP_NAME="Kush Stay"
APP_ENV=production
APP_KEY=                      # generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.example
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kushstay              # CHECK IN HOSTYCARE CPANEL — exact DB name cPanel assigns (often prefixed, e.g. user_kushstay)
DB_USERNAME=                      # CHECK IN HOSTYCARE CPANEL — DB user created in MySQL(R) Databases
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database              # No Redis required — database-backed cache/queue/session all work on shared hosting

SANCTUM_STATEFUL_DOMAINS=yourdomain.example
FRONTEND_URL=https://yourdomain.example

# WhatsApp Business Cloud API — leave blank until real credentials exist; the webhook safely
# no-ops sends (and logs instead) when these are empty. See WhatsAppWebhookController.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

MAIL_MAILER=smtp                  # CHECK IN HOSTYCARE CPANEL — outbound mail host/port/credentials
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
